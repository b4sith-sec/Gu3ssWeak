<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#000000" android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Profile" android:textSize="26sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:layout_marginTop="8dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="VULN-BOLA-01 - Broken Object Level Authorization"
        android:textSize="11sp" android:textColor="#888888" android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="You are logged in as user 5 (Alice). Your session token is scoped to your own profile - or is it? Try requesting a different user id."
        android:textSize="12sp" android:textColor="#AAAAAA"
        android:background="#0A0A0A" android:padding="14dp"
        android:lineSpacingMultiplier="1.5" android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Your token: user_token_5" android:textColor="#00FF00"
        android:textSize="12sp" android:fontFamily="monospace" android:layout_marginBottom="16dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Request user id:" android:textColor="#FFFFFF" android:textSize="13sp"/>
    <EditText android:id="@+id/et_user_id"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="5" android:textColor="#FFFFFF" android:textSize="14sp"
        android:background="#111111" android:padding="14dp"
        android:inputType="number" android:fontFamily="monospace"
        android:layout_marginBottom="12dp"/>

    <Button android:id="@+id/btn_fetch_profile"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="GET /api/user/{id}/profile" android:backgroundTint="#FFFFFF"
        android:textColor="#000000" android:textSize="13sp" android:layout_marginBottom="20dp"/>

    <TextView android:id="@+id/tv_bola_result"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#FFFF00" android:textSize="12sp"
        android:fontFamily="monospace"/>

</LinearLayout>
